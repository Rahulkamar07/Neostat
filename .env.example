# Application
APP_NAME=Document Intelligence Platform
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Persistence (SQLite file relative to project root unless absolute)
DATABASE_URL=sqlite:///./data/app.db

# Upload / validation limits
MAX_PAGES=3
MAX_UPLOAD_BYTES=15728640
VALIDATION_TOLERANCE=1.00

# OCR
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/macOS: leave empty if tesseract is on PATH
TESSERACT_CMD=
OCR_LANGUAGE=eng

# LLM — set LLM_PROVIDER to one of: openai | gemini | anthropic
# Only the matching API key is required.
LLM_PROVIDER=openai
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
